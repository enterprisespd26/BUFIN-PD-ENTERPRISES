# Security & Authentication
APP_PIN=1234
APP_PASSWORD=change-me-long-password
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Server & Database
PORT=3001
NODE_ENV=development
# Optional: Neon Postgres (pooled connection string). Without it, data is stored in ./data/state.json
DATABASE_URL=

# Cloudinary (Document & Invoice attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
